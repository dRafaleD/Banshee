// Generated by Banshee from local TOML rules. Matches are triage signals,
// not verdicts; review warning comments before deploying these rules.
import "math"

rule powershell_encoded_command : powershell execution
{
    meta:
        banshee_id = "powershell-encoded-command"
        description = "PowerShell invocation using an encoded command"
        severity = "high"
        category = "execution"
        confidence = "medium"
        attack = "TA0002, T1059.001, T1027"
        reference = "internal-playbook-7"
    strings:
        $p = /powershell(\.exe)?\s+[^\r\n]{0,120}-(enc|encodedcommand)\b/ nocase
    condition:
        $p
}

rule private_key_marker : credential secret
{
    meta:
        banshee_id = "private-key-marker"
        description = "PEM private-key material"
        severity = "critical"
    strings:
        $p = "-----BEGIN PRIVATE KEY-----"
    condition:
        $p
}

rule mz_with_wildcards : executable
{
    meta:
        banshee_id = "mz-with-wildcards"
        description = "DOS MZ marker followed by two variable bytes"
        severity = "low"
    strings:
        $p = { 4D 5A ?? ?? }
    condition:
        $p
}

rule pe_command_markers : executable compound
{
    meta:
        banshee_id = "pe-command-markers"
        description = "PE content containing a DOS stub and a command-interpreter marker"
        severity = "medium"
        category = "execution"
        confidence = "low"
    strings:
        $p = { 4D 5A }
        $all0 = "This program cannot be run in DOS mode"
        $any0 = "powershell" nocase
        $any1 = "cmd.exe" nocase
    condition:
        $p and $all0 and any of ($any*) and (uint16(0) == 0x5A4D) and math.entropy(0, filesize) >= 1
}
