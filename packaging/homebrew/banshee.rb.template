# Homebrew formula for prebuilt Banshee release archives.
class Banshee < Formula
  desc "Offline, pipe-friendly security analysis toolkit"
  homepage "https://github.com/dRafaleD/Banshee"
  version "@VERSION@"
  license "MIT"

  on_macos do
    on_arm do
      url "https://github.com/dRafaleD/Banshee/releases/download/v@VERSION@/banshee-@VERSION@-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA256_aarch64-apple-darwin@"
    end
    on_intel do
      url "https://github.com/dRafaleD/Banshee/releases/download/v@VERSION@/banshee-@VERSION@-x86_64-apple-darwin.tar.gz"
      sha256 "@SHA256_x86_64-apple-darwin@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/dRafaleD/Banshee/releases/download/v@VERSION@/banshee-@VERSION@-aarch64-unknown-linux-gnu.tar.gz"
      sha256 "@SHA256_aarch64-unknown-linux-gnu@"
    end
    on_intel do
      url "https://github.com/dRafaleD/Banshee/releases/download/v@VERSION@/banshee-@VERSION@-x86_64-unknown-linux-gnu.tar.gz"
      sha256 "@SHA256_x86_64-unknown-linux-gnu@"
    end
  end

  depends_on "xz"

  def install
    bin.install "banshee"
    man1.install "banshee.1"
    bash_completion.install "completions/banshee.bash" => "banshee"
    zsh_completion.install "completions/banshee.zsh" => "_banshee"
    fish_completion.install "completions/banshee.fish"
  end

  test do
    assert_equal "hello", shell_output("#{bin}/banshee decode base64 aGVsbG8=").strip
    system bin/"banshee", "doctor"
  end
end
